{
  "entities": {
    "CreatedVideo": {
      "title": "Created Video",
      "description": "Video compiled by Vixora Studio",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "topic": { "type": "string", "maxLength": 1000 },
        "scriptText": { "type": "string", "maxLength": 10000 },
        "videoUrl": { "type": "string", "maxLength": 5000 },
        "date": { "type": "string", "maxLength": 100 },
        "aspectRatio": { "type": "string", "maxLength": 50 },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "topic", "scriptText"]
    },
    "Voiceover": {
      "title": "Voiceover Item",
      "description": "Voiceover track generated by Vixora TTS engine",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "text": { "type": "string", "maxLength": 10000 },
        "audioBase64": { "type": "string", "maxLength": 5000000 },
        "date": { "type": "string", "maxLength": 100 },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "text"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile data and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 255 },
        "displayName": { "type": "string", "maxLength": 255 },
        "apiKey": { "type": "string", "maxLength": 255 },
        "plan": { "type": "string", "maxLength": 100 },
        "fcmToken": { "type": "string", "maxLength": 1000 },
        "updatedAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["uid"]
    },
    "Announcement": {
      "title": "Feature Announcement Advert",
      "description": "New feature update announcement or advert",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 500 },
        "message": { "type": "string", "maxLength": 5000 },
        "tag": { "type": "string", "maxLength": 100 },
        "badgeText": { "type": "string", "maxLength": 100 },
        "actionUrl": { "type": "string", "maxLength": 1000 },
        "imageUrl": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "title", "message"]
    },
    "VideoTemplate": {
      "title": "Video Production Template",
      "description": "Custom reusable video production template preset",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 255 },
        "description": { "type": "string", "maxLength": 2000 },
        "niche": { "type": "string", "maxLength": 100 },
        "aspectRatio": { "type": "string", "maxLength": 50 },
        "targetDuration": { "type": "string", "maxLength": 50 },
        "captionTemplate": { "type": "string", "maxLength": 100 },
        "sfxEnabled": { "type": "string", "maxLength": 50 },
        "bgMusicUrl": { "type": "string", "maxLength": 2000 },
        "scriptStyle": { "type": "string", "maxLength": 1000 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "title"]
    },
    "ContentRoadmap": {
      "title": "Creator Content Roadmap",
      "description": "Sister Vixora Content Master strategic roadmap plan",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 255 },
        "niche": { "type": "string", "maxLength": 100 },
        "platform": { "type": "string", "maxLength": 100 },
        "goal": { "type": "string", "maxLength": 500 },
        "roadmapItemsJson": { "type": "string", "maxLength": 20000 },
        "faithAlignment": { "type": "string", "maxLength": 2000 },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "title"]
    },
    "Project": {
      "title": "Creation Project",
      "description": "User creation project storing script, voiceover, clips, video URL and chat history",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 500 },
        "topic": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "maxLength": 100 },
        "aspectRatio": { "type": "string", "maxLength": 50 },
        "targetDuration": { "type": "string", "maxLength": 100 },
        "thumbnailUrl": { "type": "string", "maxLength": 10000 },
        "scriptText": { "type": "string", "maxLength": 50000 },
        "voiceoverUrl": { "type": "string", "maxLength": 500000 },
        "videoUrl": { "type": "string", "maxLength": 10000 },
        "chatHistoryJson": { "type": "string", "maxLength": 500000 },
        "sourcedVideosJson": { "type": "string", "maxLength": 500000 },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "title"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "User video creation projects collection"
    },
    "/videos/{videoId}": {
      "schema": { "$ref": "#/entities/CreatedVideo" },
      "description": "Collection of generated video items"
    },
    "/voiceovers/{voiceoverId}": {
      "schema": { "$ref": "#/entities/Voiceover" },
      "description": "Collection of voiceover history"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles and settings"
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "System feature announcements and update adverts"
    },
    "/templates/{templateId}": {
      "schema": { "$ref": "#/entities/VideoTemplate" },
      "description": "Video production templates collection"
    },
    "/roadmaps/{roadmapId}": {
      "schema": { "$ref": "#/entities/ContentRoadmap" },
      "description": "Content Coach roadmaps and strategies"
    }
  }
}
