rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidCreatedVideo(data) {
      return data.keys().hasAll(['id', 'topic', 'scriptText']) &&
        data.id is string && data.id.size() <= 128 &&
        data.topic is string && data.topic.size() <= 1000 &&
        data.scriptText is string && data.scriptText.size() <= 10000 &&
        (!('videoUrl' in data) || (data.videoUrl is string && data.videoUrl.size() <= 5000)) &&
        (!('date' in data) || (data.date is string && data.date.size() <= 100)) &&
        (!('aspectRatio' in data) || (data.aspectRatio is string && data.aspectRatio.size() <= 50)) &&
        (!('userId' in data) || (data.userId is string && data.userId.size() <= 128));
    }

    function isValidVoiceover(data) {
      return data.keys().hasAll(['id', 'text']) &&
        data.id is string && data.id.size() <= 128 &&
        data.text is string && data.text.size() <= 10000 &&
        (!('audioBase64' in data) || (data.audioBase64 is string && data.audioBase64.size() <= 5000000)) &&
        (!('date' in data) || (data.date is string && data.date.size() <= 100)) &&
        (!('userId' in data) || (data.userId is string && data.userId.size() <= 128));
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid']) &&
        data.uid is string && data.uid.size() <= 128 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 255)) &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 255)) &&
        (!('apiKey' in data) || (data.apiKey is string && data.apiKey.size() <= 255)) &&
        (!('fcmToken' in data) || (data.fcmToken is string && data.fcmToken.size() <= 1000)) &&
        (!('plan' in data) || (data.plan is string && data.plan.size() <= 100));
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll(['id', 'title', 'message']) &&
        data.id is string && data.id.size() <= 128 &&
        data.title is string && data.title.size() <= 500 &&
        data.message is string && data.message.size() <= 5000 &&
        (!('tag' in data) || (data.tag is string && data.tag.size() <= 100)) &&
        (!('badgeText' in data) || (data.badgeText is string && data.badgeText.size() <= 100)) &&
        (!('actionUrl' in data) || (data.actionUrl is string && data.actionUrl.size() <= 1000)) &&
        (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 2000));
    }

    function isValidVideoTemplate(data) {
      return data.keys().hasAll(['id', 'title']) &&
        data.id is string && data.id.size() <= 128 &&
        data.title is string && data.title.size() <= 255 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
        (!('niche' in data) || (data.niche is string && data.niche.size() <= 100)) &&
        (!('aspectRatio' in data) || (data.aspectRatio is string && data.aspectRatio.size() <= 50)) &&
        (!('targetDuration' in data) || (data.targetDuration is string && data.targetDuration.size() <= 50)) &&
        (!('captionTemplate' in data) || (data.captionTemplate is string && data.captionTemplate.size() <= 100)) &&
        (!('sfxEnabled' in data) || (data.sfxEnabled is string && data.sfxEnabled.size() <= 50)) &&
        (!('bgMusicUrl' in data) || (data.bgMusicUrl is string && data.bgMusicUrl.size() <= 2000)) &&
        (!('scriptStyle' in data) || (data.scriptStyle is string && data.scriptStyle.size() <= 1000)) &&
        (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 128));
    }

    function isValidContentRoadmap(data) {
      return data.keys().hasAll(['id', 'title']) &&
        data.id is string && data.id.size() <= 128 &&
        data.title is string && data.title.size() <= 255 &&
        (!('niche' in data) || (data.niche is string && data.niche.size() <= 100)) &&
        (!('platform' in data) || (data.platform is string && data.platform.size() <= 100)) &&
        (!('goal' in data) || (data.goal is string && data.goal.size() <= 500)) &&
        (!('roadmapItemsJson' in data) || (data.roadmapItemsJson is string && data.roadmapItemsJson.size() <= 20000)) &&
        (!('faithAlignment' in data) || (data.faithAlignment is string && data.faithAlignment.size() <= 2000)) &&
        (!('userId' in data) || (data.userId is string && data.userId.size() <= 128));
    }

    // Videos collection
    match /videos/{videoId} {
      allow read: if true;
      allow create: if isValidId(videoId) && isValidCreatedVideo(incoming());
      allow update: if isValidId(videoId) && isValidCreatedVideo(incoming());
      allow delete: if isValidId(videoId);
    }

    // Voiceovers collection
    match /voiceovers/{voiceoverId} {
      allow read: if true;
      allow create: if isValidId(voiceoverId) && isValidVoiceover(incoming());
      allow update: if isValidId(voiceoverId) && isValidVoiceover(incoming());
      allow delete: if isValidId(voiceoverId);
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow create: if isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if isValidId(userId);
    }

    // Announcements collection
    match /announcements/{announcementId} {
      allow read: if true;
      allow create: if isValidId(announcementId) && isValidAnnouncement(incoming());
      allow update: if isValidId(announcementId) && isValidAnnouncement(incoming());
      allow delete: if isValidId(announcementId);
    }

    // Templates collection
    match /templates/{templateId} {
      allow read: if true;
      allow create: if isValidId(templateId) && isValidVideoTemplate(incoming());
      allow update: if isValidId(templateId) && isValidVideoTemplate(incoming());
      allow delete: if isValidId(templateId);
    }

    // Roadmaps collection
    match /roadmaps/{roadmapId} {
      allow read: if true;
      allow create: if isValidId(roadmapId) && isValidContentRoadmap(incoming());
      allow update: if isValidId(roadmapId) && isValidContentRoadmap(incoming());
      allow delete: if isValidId(roadmapId);
    }
  }
}
